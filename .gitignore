# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# ...except the partner-integration public key — meant to be public, and
# must actually be present in the repo/image for the app to serve it.
!backend/api/config/partner_public.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# runtime-uploaded wine images
backend/uploads/wines/*
!backend/uploads/wines/.gitkeep

# runtime-generated export/snapshot artifacts (keep the seeded catalog CSV)
backend/exports/*
!backend/exports/wines-catalog.csv
backend/data/cart-exports/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Snyk Security Extension - AI Rules (auto-generated)
.cursor/rules/snyk_rules.mdc

# Local AI-assistant config / working docs — not for distribution.
# AppBuilder.md and tasks/ describe intentional vulnerabilities and must
# never enter the public tree (see CLAUDE.md); SupplyChain.md is a local
# working doc kept out for consistency.
CLAUDE.md
.claude/
AppBuilder.md
SupplyChain.md
tasks/

# Python
__pycache__/
*.pyc
.pytest_cache/
